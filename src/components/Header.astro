---
import { LoginButton } from "@components/LoginButton";
import SwitchDarMod from "@sections/SwitchDarMod.astro";
import { dataGlobal } from "@utils/dataGlobal";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { supabase } from "../lib/supabase";
import { Image } from "astro:assets";
import icon from "@assets/icon.svg";
import { MenuIcon, X, Link, QrCode } from "lucide-preact";

const { cookies, url } = Astro;

const isMain = url.pathname === "/es/" || url.pathname === "/en/";

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");
let email: string | undefined;

if (!accessToken || !refreshToken) {
  console.log("No hay tokens");
} else {
  const { data, error } = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  email = data?.user?.email;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  class="container mx-auto flex flex-wrap items-center justify-between px-4 py-4"
>
  <nav
    class="flex flex-row items-center gap-4 space-x-4 sm:flex-row md:flex-row lg:flex-row"
  >
    <div
      class="flex flex-row items-center gap-4 text-2xl font-bold text-blue-800 dark:text-blue-100"
    >
      <a class="flex items-center gap-x-2" href="/">
        <Image src={icon} alt="logo" width="50" height="50" />
        {dataGlobal.title}</a
      >
    </div>
    <div class="items-center gap-4 space-x-4 md:flex">
      <a class="nav-item" href=`/${lang}/`>{"Shortener"}</a>
      <a class="nav-item" href=`/${lang}/QrGenerator`>{"QRGenerator"}</a>
    </div>
    <div class="flex items-center gap-4 space-x-4">
      <SwitchDarMod />
      <LoginButton client:load />
    </div>
  </nav>
</header>
