---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { Scissors, QrCode, Link } from "lucide-preact";
import { UrlInput } from "@sections/UrlInput";
import { Table } from "@sections/Table";

import Title from "./ui/Title.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main class="main">
  {/* Hero Section */}
  <Title />
  <section
    class="mb-16 flex w-full max-w-[80%] flex-col items-center justify-center gap-4 rounded-md bg-white p-8 shadow-sm dark:bg-neutral-800 sm:gap-0 lg:max-w-[60%]"
  >
    <div class="items-center justify-center text-center">
      <div class="card-header items-center justify-center">
        <h1>{t("SH-TITLEHEADER")}</h1>
      </div>
      <p>{t("SH-DESC")}</p>
    </div>
    {/* URL Shortener Form */}
    <div class="mx-auto mt-8 w-full">
      <UrlInput lang={lang} client:only="preact" />
    </div>
  </section>
  <Table client:only="preact" />

  {/* Features Section */}
  <section class="mb-16 grid grid-cols-1 gap-8 px-5 md:grid-cols-3">
    <div class="shorten-card">
      <div class="shorten-card-header">
        <Scissors class="mb-2 h-10 w-10 text-blue-500" />
        <h3 class="mb-2 text-2xl font-bold">
          {t("SHORTEN-TITLE")}
        </h3>
      </div>
      <div>
        <p>{t("SHORTEN-DESC")}</p>
      </div>
    </div>
    <a href={"/" + lang + "/QrGenerator"} class="shorten-card">
      <div class="shorten-card-header">
        <QrCode class="mb-2 h-10 w-10 text-blue-500" />
        <h3 class="mb-2 text-2xl font-bold">
          {t("QRGENERATOR-TITLE")}
        </h3>
      </div>
      <div>
        <p>{t("QR-DESC")}</p>
      </div>
    </a>
    <div class="shorten-card">
      <div class="shorten-card-header">
        <Link class="mb-2 h-10 w-10 text-blue-500" />
        <h3 class="mb-2 text-2xl font-bold">
          {t("LINK-TITLE")}
        </h3>
      </div>
      <div>
        <p>{t("LINK-DESC")}</p>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="pb-20 text-center">
    <h2 class="mb-4 text-3xl font-bold">
      {t("CTA-TITLE")}
    </h2>
    <p class="mb-8 text-xl text-gray-600 dark:text-gray-300">
      {t("CTA-DESC")}
    </p>
    <buttom class="btn-solid">{t("CTA-BTN")}</buttom>
  </section>
</main>
