        <h1>{t("SHORTEN")}</h1>
      </div>
      <p>pega el url aqui y optene una url corta al instante</p>
    </div>
    {/* URL Shortener Form */}
    <div class="mx-auto max-w-2xl">
      <form class="flex gap-2">
        <input type="url" placeholder="https://tu-url-larga.com" required />
        <!-- <button type="submit">{t.shorten}</button> -->
      </form>
